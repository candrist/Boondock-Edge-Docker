############################################################################
# Boondock Edge — shared environment file.
#
# Copy this file to `boondock.env` (NOT `.env`) and fill in real values.
# `boondock.env` is gitignored — never commit it.
#
# Every `docker compose` invocation in this repo MUST be run as:
#   docker compose --env-file boondock.env -f <compose-file> <command>
# Compose only auto-loads a file literally named `.env` for variable
# interpolation (used below for build args, ports, and Caddy domains) — using
# a differently-named file requires --env-file on every invocation, which is
# also how the running containers get these values injected via `env_file:`.
############################################################################

# --------------------------------------------------------------------------
# Boondock-Edge-API (Flask + Flask-SocketIO)
# --------------------------------------------------------------------------

# TCP port the Flask/SocketIO server listens on inside the container.
FLASK_PORT=4000

# true = production behavior (no debug/reloader). Always leave this true for
# deployed environments.
PRODUCTION_MODE=true

# gevent|waitress|gunicorn — informational only for this Docker setup:
# run.py always serves via socketio.run() internally and only warns (then
# falls back to gevent) if this is set to "waitress"; it never actually
# hands off to gunicorn/waitress as a WSGI server. Leave as gevent.
PRODUCTION_SERVER=gevent

# auto|gevent|threading — "auto" probes gevent safely in a subprocess first
# and falls back to threading if the gevent/greenlet native wheel is
# incompatible with the host CPU. Override to "threading" if you see gevent
# probe failures in the container logs.
SOCKETIO_ASYNC_MODE=auto

# Directory (inside the container) holding persistent data: db/, recordings/,
# logs/, device_settings/, docs/. This MUST match the volume mount target in
# docker-compose.api.yml / docker-compose.yml (currently /data) — do not
# change one without the other.
BOONDOCK_DATA_ROOT=/data

# Flask session signing key. Set this explicitly in production — if left
# blank, the app auto-generates and persists one to
# $BOONDOCK_DATA_ROOT/db/.secret_key on first boot, but sessions/JWTs issued
# before you set this explicitly won't be valid afterwards, and relying on
# the auto-generated file makes secret rotation harder to reason about.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Comma-separated list of origins allowed to call /api/* and connect via
# Socket.IO (flask-cors + SocketIO's cors_allowed_origins both read this).
# MUST include https://<APP_DOMAIN> below, since the Dashboard is now served
# from a different origin than the API (subdomain routing, not same-origin
# `/api` proxying). Add any other origins you use (e.g. a LAN IP) as needed.
CORS_ALLOWED_ORIGINS=https://app.example.com

# --------------------------------------------------------------------------
# Boondock-Edge-Dashboard (React CRA, build-time only)
# --------------------------------------------------------------------------

# Full URL the Dashboard calls for all REST requests — baked into the JS
# bundle at build time (docker compose build/up --build), NOT read at
# runtime. MUST include the "/api" suffix (see docker/dashboard.Dockerfile
# comment for why) — do not set this to just the bare host.
REACT_APP_EDGE_SERVER_ENDPOINT=https://api.example.com/api

# --------------------------------------------------------------------------
# Domains & Caddy (combined deployment only — docker-compose.yml)
# --------------------------------------------------------------------------

# Public subdomain that Caddy will obtain a cert for and reverse-proxy to
# the api container.
API_DOMAIN=api.example.com

# Public subdomain that Caddy will obtain a cert for and reverse-proxy to
# the dashboard container (with /socket.io/* special-cased to the api
# container — see caddy/Caddyfile).
APP_DOMAIN=app.example.com

# Email Caddy registers with Let's Encrypt for expiry/renewal notices.
CADDY_EMAIL=you@example.com

# --------------------------------------------------------------------------
# Standalone-mode-only convenience port (docker-compose.dashboard.yml)
# --------------------------------------------------------------------------

# Host port the static dashboard is published on when running the
# Dashboard-only compose file directly (no Caddy in front). Ignored by the
# combined docker-compose.yml, where Caddy owns 80/443 instead.
DASHBOARD_PORT=8080
