{
	# Let's Encrypt account email. For local testing without real public
	# domains, see the "Local/staging testing" note in README.md instead of
	# editing this file.
	email {$CADDY_EMAIL}
}

# Single origin: Boondock-Edge-API serves both /api/* and the dashboard UI
# itself (see docker/dashboard.Dockerfile), so there's only one site block
# and no cross-origin/CORS or Socket.IO path special-casing to worry about.
{$DOMAIN} {
	encode gzip
	reverse_proxy api:{$FLASK_PORT}
}
